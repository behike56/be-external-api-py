// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-docker-compose
{
	"name": "FastAPI Dev Container(be-external-api-py)",

	// docker-compose.yml を使用して複数コンテナ (app + db) を立ち上げる
	"dockerComposeFile": "compose.yaml",

	// メインの開発対象サービス（コンテナ）を指定
	"service": "api",

	// コンテナ内でのワークスペース
	"workspaceFolder": "/workspace",

	// コンテナが起動したら自動的にPython依存パッケージをインストールしてもよい
	// (requirements-dev.txt などを再インストールしたい場合に便利)
	// "postCreateCommand": "pip install --no-cache-dir -r requirements-dev.txt",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Uncomment the next line if you want start specific services in your Docker Compose config.
	// "runServices": [],

	// Uncomment the next line if you want to keep your containers running after VS Code shuts down.
	// "shutdownAction": "none",

	// Uncomment the next line to run commands after the container is created.
	// "postCreateCommand": "cat /etc/os-release",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			// 事前にゲストOS上のVSCodeで利用する拡張をインストールします
			"extensions": [
				// 全リポジトリにインストール
				"EditorConfig.EditorConfig",
				"johnpapa.vscode-peacock",
				"ms-ceintl.vscode-language-pack-ja",
				// Document
				"docsmsft.docs-yaml",
				"yzhang.markdown-all-in-one",
				"marp-team.marp-vscode",
				// 以下 python用の拡張
				"ms-python.python",
				"njpwerner.autodocstring",
				"tamasfe.even-better-toml",
				"charliermarsh.ruff",
				"kevinrose.vsc-python-indent",
				"evondev.indent-rainbow-palettes"
			]
		},
		  // (例) コンテナ内のVS Code設定 (必要に応じて)
		  "settings": {
			"terminal.integrated.fontFamily": "MesloLGS NF",
			"terminal.integrated.fontSize": 14,
			"editor.fontFamily": "Fira Code",
			"editor.fontLigatures": true,
			"editor.fontSize": 15,
			"workbench.colorTheme": "GrunBoxTheme",
			"workbench.iconTheme": "simple-icons",
			"editor.minimap.enabled": false,
			"[python]": {
				"editor.defaultFormatter": "charliermarsh.ruff"
			},
			"indentRainbow.colors": [
				"rgba(247, 37, 133,0.15)",
				"rgba(181, 23, 158,0.15)",
				"rgba(114, 9, 183, 0.15)",
				"rgba(86, 11, 173,0.15)",
				"rgba(72, 12, 168,0.15)",
				"rgba(58, 12, 163,0.15)",
				"rgba(63, 55, 201,0.15)",
				"rgba(63, 55, 201,0.1)",
				"rgba(63, 55, 201,0.05)",
				"rgba(63, 55, 201,0.025)"
			],
			"yaml.schemas": {
				"file:///Users/behike56/.vscode/extensions/docsmsft.docs-yaml-1.0.5/dist/toc.schema.json": "/toc\\.yml/i"
			},
			"[yaml]": {
				"editor.defaultFormatter": "redhat.vscode-yaml"
			},
			"editor.unicodeHighlight.ambiguousCharacters": false,
			"[html]": {
				"editor.defaultFormatter": "vscode.html-language-features"
			},
			"git.enableCommitSigning": true
		  }
	}

	// Uncomment to connect as an existing user other than the container default. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "vscode"
}
